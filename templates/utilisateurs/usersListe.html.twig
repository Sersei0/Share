{% extends 'base.html.twig' %}

{% block title %}{{parent()}} Liste des utilisateurs{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <h1 class="text-center text-primary mt-4 pt-4 display-1 fw-bold">Liste des utilisateurs</h1>
            <div class="col-12 col-md-8 bg-white p-4 m-0 text-primary">
                <div class="table-responsive">
                    {{form_start(trieUser)}}
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th scope="col">Email</th>
                                <th scope="col">Date d'inscription</th>
                            </tr>
                        </thead>
                        <tbody>
                            {%for user in listeUser%}
                                    <tr class="{{cycle(['table-primary', 'table-secondary'], loop.index0)}}">
                                        <td>{{user.email | lower}}</td>
                                        <td>{{user.DateInscription | date("d-m-Y")}}</td>
                                    </tr>
                            {%endfor %}
                        </tbody> 
                    </table>
                    {{form_widget(trieUser.Trier) }}
                    {{form_end(trieUser)}}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
