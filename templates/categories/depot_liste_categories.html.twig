{% extends 'base.html.twig' %}

{% block title %}{{parent()}}Liste des catégories{% endblock %}

{% block body %}
    <div class="container-fluid">
        <h1 class="text-center text-primary mt-4 pt-4 display-1 fw-bold">Liste des catégories existantes</h1>

        <div class="row justify-content-center">
            <div class="col-12 col-md-8 bg-white p-4 m-0 text-primary">
                <div class="table-responsive">
                    {{form_start(form_supprMultiple)}}
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th scope="col">Catégorie</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {%for categorie in categories | sort((a, b) => a.Categorie <=> b.Categorie) %}
                                <tr class="{{cycle(['table-primary', 'table-secondary'], loop.index0)}}">
                                    <td>{{categorie.Categorie | capitalize}}</td>
                                    <td>
                                        <a href="{{path('app_modify_categorie', {'id' : categorie.id})}}"><i class="bi bi-pencil-square text-dark"></i></a>
                                        <a href="{{path('app_removeCategorie', {'id' : categorie.id})}}"><i class="bi bi-trash3 text-dark"></i></a>
                                    </td>
                                    <td>
                                        {{form_widget(form_supprMultiple.categories[categorie.id]) }}
                                    </td>
                                    
                                </tr>
                            {%endfor %}
                        </tbody> 
                    </table>
                    {{form_widget(form_supprMultiple.Supprimer)}}
                    {{form_end(form_supprMultiple)}}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
